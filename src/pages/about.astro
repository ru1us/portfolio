</Layout>

<script>
  // 3D Depth Illusion Effect with VIDEO
  class DepthIllusionVideo {
    private container: HTMLElement;
    private colorVideo: HTMLVideoElement;
    private wireVideo: HTMLVideoElement;
    private depthMap: HTMLImageElement;
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private depthCanvas: HTMLCanvasElement;
    private depthCtx: CanvasRenderingContext2D;
    private maxDisplacement: number = 20;
    private animationFrameId: number | null = null;
    private currentOffsetX: number = 0;
    private currentOffsetY: number = 0;
    private colorOpacity: number = 1;
    private wireOpacity: number = 0;
    private targetColorOpacity: number = 1;
    private targetWireOpacity: number = 0;
    private opacityTransitionSpeed: number = 0.15;
    private BASE_URL: string = import.meta.env.BASE_URL;

    constructor() {
      this.container = document.getElementById(
        "depth-container"
      ) as HTMLElement;
      this.colorVideo = document.getElementById(
        "color-video"
      ) as HTMLVideoElement;
      this.wireVideo = document.getElementById(
        "wire-video"
      ) as HTMLVideoElement;
      this.depthMap = document.getElementById("depth-map") as HTMLImageElement;

      if (this.container && this.colorVideo && this.wireVideo && this.depthMap) {
        this.init();
        this.setupHoverHandler();
      }
    }

    setupHoverHandler() {
      this.container.addEventListener("mouseenter", () => {
        this.switchToWireframe();
      });
      
      this.container.addEventListener("mouseleave", () => {
        this.switchToNormal();
      });
    }

    switchToWireframe() {
      // Crossfade to wireframe
      this.targetColorOpacity = 0;
      this.targetWireOpacity = 1;
    }

    switchToNormal() {
      // Crossfade to color
      this.targetColorOpacity = 1;
      this.targetWireOpacity = 0;
    }

    async init() {
      // Ensure both videos play
      this.colorVideo
        .play()
        .catch((err) => console.log("Video autoplay prevented:", err));
      this.wireVideo
        .play()
        .catch((err) => console.log("Video autoplay prevented:", err));

      // Wait for video and depth map to load
      await Promise.all([
        this.waitForVideo(this.colorVideo),
        this.waitForImage(this.depthMap),
      ]);

      // Create canvas for rendering
      this.canvas = document.createElement("canvas");
      this.canvas.className = "w-full h-full object-contain";
      this.canvas.style.backgroundColor = "transparent";

      // Calculate canvas size to fit container height
      const containerHeight = this.container.clientHeight;
      const videoAspectRatio =
        this.colorVideo.videoWidth / this.colorVideo.videoHeight;

      this.canvas.height = containerHeight;
      this.canvas.width = containerHeight * videoAspectRatio;

      this.ctx = this.canvas.getContext("2d", {
        willReadFrequently: true,
        alpha: true,
      })!;

      // Create offscreen canvas for depth map
      this.depthCanvas = document.createElement("canvas");
      this.depthCanvas.width = this.depthMap.naturalWidth;
      this.depthCanvas.height = this.depthMap.naturalHeight;
      this.depthCtx = this.depthCanvas.getContext("2d", {
        willReadFrequently: true,
      })!;
      this.depthCtx.drawImage(this.depthMap, 0, 0);

      // Add canvas to container
      this.container.appendChild(this.canvas);

      // Mouse tracking on entire document
      document.addEventListener("mousemove", (e: MouseEvent) => {
        const x = e.clientX / window.innerWidth;
        const y = e.clientY / window.innerHeight;

        this.currentOffsetX = (x - 0.5) * 2;
        this.currentOffsetY = (y - 0.5) * 2;
      });

      document.addEventListener("mouseleave", () => {
        this.currentOffsetX = 0;
        this.currentOffsetY = 0;
      });

      // Start animation loop
      const animate = () => {
        // Smooth opacity transitions
        this.colorOpacity += (this.targetColorOpacity - this.colorOpacity) * this.opacityTransitionSpeed;
        this.wireOpacity += (this.targetWireOpacity - this.wireOpacity) * this.opacityTransitionSpeed;
        
        this.render(this.currentOffsetX, this.currentOffsetY);
        this.animationFrameId = requestAnimationFrame(animate);
      };
      animate();
    }

    waitForVideo(video: HTMLVideoElement): Promise<void> {
      return new Promise((resolve) => {
        if (video.readyState >= 3) {
          resolve();
        } else {
          video.addEventListener("canplay", () => resolve(), { once: true });
        }
      });
    }

    waitForImage(img: HTMLImageElement): Promise<void> {
      return new Promise((resolve) => {
        if (img.complete) {
          resolve();
        } else {
          img.onload = () => resolve();
        }
      });
    }

    render(offsetX: number, offsetY: number) {
      const width = this.canvas.width;
      const height = this.canvas.height;

      // Clear canvas with transparency
      this.ctx.clearRect(0, 0, width, height);

      // Get depth map data (cached)
      const depthData = this.depthCtx.getImageData(
        0,
        0,
        this.depthCanvas.width,
        this.depthCanvas.height
      );

      // Draw both video frames to temporary canvases
      const tempCanvas1 = document.createElement("canvas");
      tempCanvas1.width = width;
      tempCanvas1.height = height;
      const tempCtx1 = tempCanvas1.getContext("2d")!;
      tempCtx1.drawImage(this.colorVideo, 0, 0, width, height);
      const colorData = tempCtx1.getImageData(0, 0, width, height);

      const tempCanvas2 = document.createElement("canvas");
      tempCanvas2.width = width;
      tempCanvas2.height = height;
      const tempCtx2 = tempCanvas2.getContext("2d")!;
      tempCtx2.drawImage(this.wireVideo, 0, 0, width, height);
      const wireData = tempCtx2.getImageData(0, 0, width, height);

      // Create output image data
      const outputData = this.ctx.createImageData(width, height);

      // Apply displacement based on depth map
      for (let y = 0; y < height; y++) {
        for (let x = 0; x < width; x++) {
          // Get depth value
          const depthX = Math.floor((x / width) * this.depthCanvas.width);
          const depthY = Math.floor((y / height) * this.depthCanvas.height);
          const depthIndex = (depthY * this.depthCanvas.width + depthX) * 4;
          const depth = depthData.data[depthIndex] / 255;

          // Calculate displacement
          const displaceX = Math.round(offsetX * this.maxDisplacement * depth);
          const displaceY = Math.round(offsetY * this.maxDisplacement * depth);

          // Source pixel coordinates
          const sourceX = Math.max(0, Math.min(width - 1, x - displaceX));
          const sourceY = Math.max(0, Math.min(height - 1, y - displaceY));

          const sourceIndex = (sourceY * width + sourceX) * 4;
          const targetIndex = (y * width + x) * 4;

          // Blend pixels from both videos
          const r = colorData.data[sourceIndex] * this.colorOpacity + wireData.data[sourceIndex] * this.wireOpacity;
          const g = colorData.data[sourceIndex + 1] * this.colorOpacity + wireData.data[sourceIndex + 1] * this.wireOpacity;
          const b = colorData.data[sourceIndex + 2] * this.colorOpacity + wireData.data[sourceIndex + 2] * this.wireOpacity;
          const a = Math.max(colorData.data[sourceIndex + 3], wireData.data[sourceIndex + 3]);

          outputData.data[targetIndex] = r;
          outputData.data[targetIndex + 1] = g;
          outputData.data[targetIndex + 2] = b;
          outputData.data[targetIndex + 3] = a;
        }
      }

      this.ctx.putImageData(outputData, 0, 0);
    }

    destroy() {
      if (this.animationFrameId) {
        cancelAnimationFrame(this.animationFrameId);
      }
    }
  }

  // Initialize when DOM is loaded
  document.addEventListener("DOMContentLoaded", () => {
    new DepthIllusionVideo();
  });
</script>
