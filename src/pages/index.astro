              height="192"
              class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-300"
            />
          </div>
          <div class="p-4">
            <h3 class="font-heading font-bold text-base mb-2">
              KLAPP | Product Design
            </h3>
            <p class="text-sm text-slate-600 mb-3">
