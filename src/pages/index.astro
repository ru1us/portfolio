              >
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    // Card Tilt Effect - Only for Index Page
    class CardTiltEffect {
      cards: any[] = [];

      constructor() {
        this.init();
      }

      init() {
        const cardElements = document.querySelectorAll(".card-3d");

        cardElements.forEach((card) => {
          this.setupCard(card as HTMLElement);
        });
      }

      setupCard(cardElement: HTMLElement) {
        const cardData = {
          element: cardElement,
          maxTilt: 8, // Subtle effect
        };

        this.cards.push(cardData);

        // Add event listeners
        cardElement.addEventListener("mousemove", (e: MouseEvent) =>
          this.onMouseMove(e, cardData)
        );
        cardElement.addEventListener("mouseleave", (e: MouseEvent) =>
          this.onMouseLeave(e, cardData)
        );
      }

      onMouseMove(event: MouseEvent, cardData: any) {
        const card = cardData.element;
        const rect = card.getBoundingClientRect();

        // Calculate mouse position relative to card (0 to 1)
        const x = (event.clientX - rect.left) / rect.width;
        const y = (event.clientY - rect.top) / rect.height;

        // Convert to rotation values (-1 to 1, then to degrees)
        const rotateY = (x - 0.5) * 2 * cardData.maxTilt;
        const rotateX = (y - 0.5) * -2 * cardData.maxTilt;

        // Apply subtle rotation
        card.style.transform = `
        perspective(1000px) 
        rotateX(${rotateX}deg) 
        rotateY(${rotateY}deg) 
        scale3d(1.02, 1.02, 1.02)
      `;
      }

      onMouseLeave(event: MouseEvent, cardData: any) {
        // Return to original position
        cardData.element.style.transform = `
        perspective(1000px) 
        rotateX(0deg) 
        rotateY(0deg) 
        scale3d(1, 1, 1)
      `;
      }
    }

    // Typing Animation Effect
    class TypingAnimation {
      private element: HTMLElement;
      private words: string[];
      private currentWordIndex: number = 0;
      private currentText: string = "";
      private isDeleting: boolean = false;
      private typingSpeed: number = 100;
      private deletingSpeed: number = 50;
      private pauseDuration: number = 1500;

      constructor() {
        this.element = document.querySelector(".typing-text") as HTMLElement;
        this.words = [
          "3D Design",
          "UI/UX Design",
          "Brand Identity",
          "Product Design",
          "Web Design",
        ];
        if (this.element) {
          this.type();
        }
      }

      type() {
        const currentWord = this.words[this.currentWordIndex];

        if (this.isDeleting) {
          this.currentText = currentWord.substring(
            0,
            this.currentText.length - 1
          );
        } else {
          this.currentText = currentWord.substring(
            0,
            this.currentText.length + 1
          );
        }

        this.element.textContent = this.currentText;

        let speed = this.isDeleting ? this.deletingSpeed : this.typingSpeed;

        if (!this.isDeleting && this.currentText === currentWord) {
          speed = this.pauseDuration;
          this.isDeleting = true;
        } else if (this.isDeleting && this.currentText === "") {
          this.isDeleting = false;
          this.currentWordIndex =
            (this.currentWordIndex + 1) % this.words.length;
          speed = 500;
        }

        setTimeout(() => this.type(), speed);
      }
    }

    // Mouse-tracked Gradient Effect
    class MouseGradientEffect {
      private gradientText: HTMLElement;

      constructor() {
        this.gradientText = document.querySelector(
          ".gradient-text"
        ) as HTMLElement;
        if (this.gradientText) {
          this.init();
        }
      }

      init() {
        // Track mouse movement across the entire viewport
        document.addEventListener("mousemove", (e: MouseEvent) => {
          const mouseX = e.clientX;
          const windowWidth = window.innerWidth;

          // Map mouse position to a ratio (0 to 1)
          const ratio = mouseX / windowWidth;

          // Create a bell curve effect - maximum red at center (0.5), black at edges (0 and 1)
          // Using a parabolic function: intensity peaks at center
          let intensity;
          if (ratio <= 0.5) {
            // Left half: goes from 0 (at 0) to 1 (at 0.5)
            intensity = ratio * 2;
          } else {
            // Right half: goes from 1 (at 0.5) to 0 (at 1)
            intensity = 2 - ratio * 2;
          }

          // Square the intensity for sharper curve (more black, only center is red)
          intensity = Math.pow(intensity, 2);

          // Interpolate from black to red based on intensity
          const r = Math.round(220 * intensity);
          const g = Math.round(38 * intensity);
          const b = Math.round(38 * intensity);

          this.gradientText.style.color = `rgb(${r}, ${g}, ${b})`;
        });

        // Reset to black on mouse leave
        document.addEventListener("mouseleave", () => {
          this.gradientText.style.color = "#000000";
        });
      }
    }
    // Initialize when DOM is loaded
    document.addEventListener("DOMContentLoaded", () => {
      new CardTiltEffect();
      new MouseGradientEffect();
      new TypingAnimation();
    });
  </script>

  <script is:inline>
    // GSAP Video Scrubbing
    const gsapScript = document.createElement("script");
    gsapScript.src =
      "https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js";
    gsapScript.onload = () => {
      const stScript = document.createElement("script");
      stScript.src =
        "https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js";
      stScript.onload = () => {
        initVideoScroll();
      };
      document.head.appendChild(stScript);
    };
    document.head.appendChild(gsapScript);

    function initVideoScroll() {
      const video = document.getElementById("scroll-video");
      const videoContainer = document.getElementById("video-container");
      const section = document.getElementById("case-study");
      const sectionMobile = document.getElementById("case-study-mobile");
      const heroBoxes = document.getElementById("hero-boxes");

      // Fade in content after load
      setTimeout(() => {
        if (heroBoxes) {
          heroBoxes.style.opacity = "1";
        }
        if (section) {
          section.style.opacity = "1";
        }
        if (sectionMobile) {
          sectionMobile.style.opacity = "1";
        }
      }, 500);

      if (!video || !videoContainer || !section) return;

      // Position video container
      const positionContainer = () => {
        const rect = section.getBoundingClientRect();
        const left = rect.left;
        const viewportWidth = document.documentElement.clientWidth;

        videoContainer.style.marginLeft = `-${left}px`;
        videoContainer.style.width = `${viewportWidth}px`;
        videoContainer.style.maxWidth = `${viewportWidth}px`;
      };

      positionContainer();
      window.addEventListener("resize", positionContainer);

      // Setup ScrollTrigger
      const setupScrollTrigger = () => {
        if (!video.duration || isNaN(video.duration)) {
          setTimeout(setupScrollTrigger, 200);
          return;
        }

        gsap.registerPlugin(ScrollTrigger);

        ScrollTrigger.create({
          trigger: videoContainer,
          start: "top top",
          end: () => `+=${section.offsetHeight - videoContainer.offsetHeight}`,
          scrub: 1,
          pin: true,
          anticipatePin: 1,
          onUpdate: (self) => {
            video.currentTime = self.progress * video.duration;
          },
        });
      };

      setTimeout(setupScrollTrigger, 1000);
    }
  </script>

  <!-- Interactive Video Control Script -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const video = document.getElementById("interactive-video");
      const interactiveArea = document.getElementById("interactive-area");
      const zones = document.querySelectorAll("[data-zone]");
      const leftInfoContainer = document.getElementById("left-info-container");
      const centerInfoContainer = document.getElementById(
        "center-info-container"
      );
      const rightInfoContainer = document.getElementById(
        "right-info-container"
      );
      const hoverInstruction = document.getElementById("hover-instruction");

      if (!video || !interactiveArea || zones.length === 0) return;

      // Video parameters
      const FPS = 24;
      const TOTAL_FRAMES = 95;

      // Target frames based on zone
      const FRAME_LEFT = 25;
      const FRAME_CENTER = 48;
      const FRAME_RIGHT = 73;
      const FRAME_START = 0;
      const FRAME_END = 95;

      // Current state
      let currentTargetFrame = FRAME_START;
      let lastKnownZone = null; // Track last zone before leaving
      let isAnimating = false;
      let animationFrame = null;
      let isInsideArea = false;

      // Convert frame to time
      const frameToTime = (frame) => frame / FPS;

      // Interpolate video to target frame
      const animateToFrame = (targetFrame, speed = 1) => {
        if (isAnimating) {
          cancelAnimationFrame(animationFrame);
        }

        currentTargetFrame = targetFrame;
        const targetTime = frameToTime(targetFrame);
        const currentTime = video.currentTime;
        const difference = targetTime - currentTime;

        // Don't animate if already at target
        if (Math.abs(difference) < 0.01) {
          video.currentTime = targetTime;
          return;
        }

        isAnimating = true;
        const startTime = performance.now();
        const duration = Math.abs(difference) * 200 * speed; // Adjustable speed

        const animate = (currentTimeStamp) => {
          const elapsed = currentTimeStamp - startTime;
          const progress = Math.min(elapsed / duration, 1);

          // Linear interpolation (no easing)
          const easeProgress = progress;

          video.currentTime = currentTime + difference * easeProgress;

          if (progress < 1) {
            animationFrame = requestAnimationFrame(animate);
          } else {
            isAnimating = false;
            video.currentTime = targetTime;
          }
        };

        animationFrame = requestAnimationFrame(animate);
      };

      // Determine which zone the mouse is in
      const getZoneFromEvent = (e) => {
        const target = e.target.closest("[data-zone]");
        return target ? target.dataset.zone : null;
      };

      // Show/hide info container based on zone
      const updateInfoContainer = (zone) => {
        if (zone === "left" && leftInfoContainer) {
          leftInfoContainer.style.opacity = "1";
          centerInfoContainer.style.opacity = "0";
          rightInfoContainer.style.opacity = "0";
        } else if (zone === "center" && centerInfoContainer) {
          centerInfoContainer.style.opacity = "1";
          leftInfoContainer.style.opacity = "0";
          rightInfoContainer.style.opacity = "0";
        } else if (zone === "right" && rightInfoContainer) {
          rightInfoContainer.style.opacity = "1";
          leftInfoContainer.style.opacity = "0";
          centerInfoContainer.style.opacity = "0";
        } else {
          if (leftInfoContainer) leftInfoContainer.style.opacity = "0";
          if (centerInfoContainer) centerInfoContainer.style.opacity = "0";
          if (rightInfoContainer) rightInfoContainer.style.opacity = "0";
        }
      };

      // Mouse move handler
      const handleMouseMove = (e) => {
        const zone = getZoneFromEvent(e);

        if (!zone) return;

        lastKnownZone = zone;

        // Update info container visibility
        updateInfoContainer(zone);

        let targetFrame;

        switch (zone) {
          case "left":
            targetFrame = FRAME_LEFT;
            break;
          case "center":
            targetFrame = FRAME_CENTER;
            break;
          case "right":
            targetFrame = FRAME_RIGHT;
            break;
        }

        // Only animate if target changed
        if (targetFrame !== currentTargetFrame) {
          animateToFrame(targetFrame);
        }
      };

      // Mouse enter handler for interactive area
      const handleMouseEnter = (e) => {
        isInsideArea = true;

        // Hide hover instruction on first interaction
        if (hoverInstruction && hoverInstruction.style.opacity !== "0") {
          hoverInstruction.style.opacity = "0";
          setTimeout(() => {
            if (hoverInstruction.parentNode) {
              hoverInstruction.parentNode.removeChild(hoverInstruction);
            }
          }, 500);
        }

        const zone = getZoneFromEvent(e);

        if (!zone) return;

        // Determine starting frame based on entry zone
        let startFrame;
        let targetFrame;

        switch (zone) {
          case "left":
            startFrame = FRAME_START; // Enter left from 0
            targetFrame = FRAME_LEFT;
            break;
          case "center":
            // Enter center from closest end
            startFrame =
              currentTargetFrame <= FRAME_CENTER ? FRAME_START : FRAME_END;
            targetFrame = FRAME_CENTER;
            break;
          case "right":
            startFrame = FRAME_END; // Enter right from 95
            targetFrame = FRAME_RIGHT;
            break;
        }

        // Set starting position
        video.currentTime = frameToTime(startFrame);
        currentTargetFrame = startFrame;

        // Animate to target
        animateToFrame(targetFrame);
        lastKnownZone = zone;
      };

      // Mouse leave handler
      const handleMouseLeave = () => {
        isInsideArea = false;

        // Hide all info containers
        if (leftInfoContainer) leftInfoContainer.style.opacity = "0";
        if (centerInfoContainer) centerInfoContainer.style.opacity = "0";
        if (rightInfoContainer) rightInfoContainer.style.opacity = "0";

        // Go to nearest end based on last known zone
        let targetFrame;

        if (lastKnownZone === "left") {
          targetFrame = FRAME_START;
        } else if (lastKnownZone === "right") {
          targetFrame = FRAME_END;
        } else {
          // Center - go to closest end
          targetFrame =
            currentTargetFrame <= FRAME_CENTER ? FRAME_START : FRAME_END;
        }

        animateToFrame(targetFrame, 0.8); // Slightly faster exit animation
      };

      // Ensure video is loaded
      video.addEventListener("loadedmetadata", () => {
        video.currentTime = frameToTime(FRAME_START);
      });

      // Add event listeners to interactive area
      interactiveArea.addEventListener("mouseenter", handleMouseEnter);
      interactiveArea.addEventListener("mouseleave", handleMouseLeave);
      interactiveArea.addEventListener("mousemove", handleMouseMove);
    });
  </script>

  <script>
    // Fly-in Animation on Scroll
    document.addEventListener("DOMContentLoaded", () => {
      const observerOptions = {
        root: null,
        rootMargin: "0px",
        threshold: 0.1,
      };

      const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove("opacity-0", "translate-x-20");
            entry.target.classList.add("opacity-100", "translate-x-0");
          } else {
            entry.target.classList.remove("opacity-100", "translate-x-0");
            entry.target.classList.add("opacity-0", "translate-x-20");
          }
        });
      }, observerOptions);

      const cards = document.querySelectorAll(".fly-in-card");
      cards.forEach((card) => observer.observe(card));
    });
  </script>

