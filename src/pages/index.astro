      class="absolute inset-0 flex items-center justify-center pointer-events-none transition-opacity duration-500 z-20"
    >
      <div
        class="bg-slate-50/10 backdrop-blur-sm border px-64 py-10 rounded-3xl shadow-xl flex flex-col items-center gap-6"
