---
import FullWidthLayout from "../layouts/FullWidthLayout.astro";

const BASE_URL = import.meta.env.BASE_URL;
---

<FullWidthLayout title="Portfolio | Rufus Plaga">
  <main class="w-full pt-24 px-[5%] sm:px-[10%] lg:px-[20%]">
    <!-- Hero Section - Full Width, 80% Height -->
    <section
      id="hero"
      class="w-full h-auto sm:h-[80vh] flex flex-col justify-center mx-auto scroll-fade py-12 sm:py-0"
    >
      <!-- Header: Name & Title - Full Width -->
      <div class="w-full text-center mb-12 sm:mb-20">
        <h1
          class="text-4xl sm:text-6xl md:text-8xl font-heading font-bold mb-4 sm:mb-6"
        >
          <span class="gradient-text">I'm Rufus</span>
          <span class="block sm:inline text-xs sm:text-sm font-normal italic"
            >(Latin: "red")</span
          >
        </h1>
        <!-- <h2 class="text-4xl mb-8">
        Red isn't just a color — it's my <span class="text-red-600">name.</span>
      </h2> -->
        <h2 class="text-2xl sm:text-3xl md:text-4xl mb-6 sm:mb-8">
          I do <span class="text-red-600 typing-text"></span><span
            class="typing-cursor text-red-600">|</span
          >
        </h2>
        <h3
          class="text-lg sm:text-xl md:text-2xl font-heading font-light text-slate-500"
        >
          Media Design Student (B.Sc.)
        </h3>
      </div>

      <!-- 4 Boxes in a Row - Full Width -->
      <div
        id="hero-boxes"
        class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 opacity-0 transition-opacity duration-700"
      >
        <!-- 1. Skills Box -->
        <div
          class="border border-slate-400 p-6 w-full h-full flex flex-col justify-start card-3d"
        >
          <h3 class="font-heading font-bold text-base mb-3 text-slate-900">
            Skills
          </h3>
          <ul class="text-sm text-slate-700 space-y-2">
            <li class="flex items-center">
              <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-red-600 rounded-full mr-3 flex-shrink-0"></span>3D
              Modeling & Rendering
            </li>
            <li class="flex items-center">
              <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-red-600 rounded-full mr-3 flex-shrink-0"></span>UI/UX
              Design
            </li>
            <li class="flex items-center">
              <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-red-600 rounded-full mr-3 flex-shrink-0"></span>Graphic
              Design
            </li>
            <li class="flex items-center">
              <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-red-600 rounded-full mr-3 flex-shrink-0"></span>Web
              Development
            </li>
          </ul>
        </div>

        <!-- 2. Tools Box -->
        <div
          class="border border-slate-400 p-6 w-full h-full flex flex-col justify-start card-3d"
        >
          <h3 class="font-heading font-bold text-base mb-3 text-slate-900">
            Tools
          </h3>
          <ul class="text-sm text-slate-700 space-y-2">
            <li class="flex items-center">
              <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-red-600 rounded-full mr-3 flex-shrink-0"></span>Adobe CC
              (Ps, Ai, Id, Pr, Ae, ...)
            </li>
            <li class="flex items-center">
              <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-red-600 rounded-full mr-3 flex-shrink-0"></span>Blender
            </li>
            <li class="flex items-center">
              <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-red-600 rounded-full mr-3 flex-shrink-0"
              ></span>SolidWorks
            </li>
            <li class="flex items-center">
              <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-red-600 rounded-full mr-3 flex-shrink-0"></span>Java,
              JavaScript, HTML, CSS, Dart
            </li>
          </ul>
        </div>

        <!-- 3. About Me Box -->
        <div
          class="border border-slate-400 p-6 w-full h-full flex flex-col justify-start card-3d cursor-pointer hover:border-slate-500 transition-colors relative group"
          onclick={`window.location.href='${BASE_URL}about'`}
        >
          <!-- Arrow Icon -->
          <div class="absolute top-4 right-4 w-5 h-5 text-red-600">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              height="20px"
              viewBox="0 -960 960 960"
              width="20px"
              class="group-hover:scale-125 transition-transform"
              fill="currentColor"
            >
              <path d="m256-240-56-56 384-384H240v-80h480v480h-80v-344L256-240Z"
              ></path>
            </svg>
          </div>

          <h3 class="font-heading font-bold text-base mb-3 text-slate-900">
            About Me
          </h3>
          <p class="text-sm text-slate-700">
            Brief description about myself and my background.
          </p>
        </div>

        <!-- 4. All Projects Box -->
        <div
          class="border border-slate-400 p-6 w-full h-full flex flex-col justify-start card-3d cursor-pointer hover:border-slate-500 transition-colors relative group"
          onclick={`window.location.href='${BASE_URL}projects'`}
        >
          <!-- Arrow Icon -->
          <div class="absolute top-4 right-4 w-5 h-5 text-red-600">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              height="20px"
              viewBox="0 -960 960 960"
              width="20px"
              class="group-hover:scale-125 transition-transform"
              fill="currentColor"
            >
              <path d="m256-240-56-56 384-384H240v-80h480v480h-80v-344L256-240Z"
              ></path>
            </svg>
          </div>

          <h3 class="font-heading font-bold text-base mb-3 text-slate-900">
            All Projects
          </h3>
        </div>
      </div>
    </section>

    <!-- Case Study Section - Video Background mit scrollbarem Text -->
    <section
      id="case-study"
      class="relative hidden md:block min-h-[400vh] opacity-0 transition-opacity duration-700"
    >
      <!-- Heading und Text mit Padding -->
      <div class="flex justify-center mt-8 mb-8">
        <button
          id="scroll-down-btn"
          class="flex flex-col items-center gap-2 text-slate-500 hover:text-red-600 transition-colors duration-300 cursor-pointer"
        >
          <span class="text-sm font-medium tracking-widest">SCROLL</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="animate-bounce"
          >
            <path d="M12 5v14M19 12l-7 7-7-7"></path>
          </svg>
        </button>
      </div>

      <script>
        document.addEventListener("DOMContentLoaded", () => {
          const scrollBtn = document.getElementById("scroll-down-btn");
          if (scrollBtn) {
            scrollBtn.addEventListener("click", () => {
              window.scrollBy({
                top: 1000,
                behavior: "smooth",
              });
            });
          }
        });
      </script>
      <div class="w-full text-center mb-12 sm:mb-20">
        <h1
          class="hidden md:block text-3xl sm:text-4xl md:text-5xl font-heading font-bold mb-4 sm:mb-6"
        >
          Case Study
        </h1>
        <p class="hidden md:block text-lg text-slate-500">
          This project mixes public and private design. It takes the shape of a
          park bench and turns it into a comfortable sofa for your home. The
          result is a piece of furniture that looks like it belongs outside but
          feels cozy enough for your living room.
        </p>
      </div>

      <div class="w-full text-center mb-12 sm:mb-20 mt-20">
        <h2
          class="hidden md:block text-2xl sm:text-3xl md:text-4xl font-heading font-bold mb-4 sm:mb-6"
        >
          Have a seat!
        </h2>
      </div>

      <!-- Mobile Desktop Notice -->
      <div
        class="md:hidden flex items-center justify-center min-h-screen px-6 text-center"
      >
        <p class="text-xl text-slate-700 leading-relaxed">
          For the full experience, please view on desktop.
        </p>
      </div>

      <!-- Video + Text Container - FULL WIDTH -->
      <div class="hidden md:block relative h-full">
        <!-- Video Container - Sticky Background -->
        <div
          id="video-container"
          class="sticky top-0 h-screen overflow-hidden bg-slate-50 -z-10"
        >
          <video
            id="scroll-video"
            src="/index/output3.mp4"
            class="w-full h-screen object-cover"
            preload="auto"
            muted
            playsinline></video>
        </div>

        <!-- Scrollbarer Text - Overlay -->
        <!-- TEXT_START: Ändere pt-XX um zu steuern wann Text erscheint -->
        <div class="absolute top-[-25vh] left-0 right-0 pointer-events-none">
          <div
            class="ml-auto md:w-[76.92%] lg:w-[53.85%] 2xl:w-[38.46%] pointer-events-auto"
          >
            <div class="min-h-[300vh] items-start pt-[175vh] pb-20 px-0">
              <div class="min-h-[85vh] flex flex-col justify-center gap-6">
                <!-- Card 1: Idea -->
                <div
                  class="backdrop-blur-md bg-slate-50/40 border border-slate-200 rounded-lg p-8 w-full fly-in-card opacity-0 translate-x-20 transition-all duration-1000 ease-out"
                >
                  <h3
                    class="text-xl font-heading font-semibold mb-3 text-slate-900"
                  >
                    Idea
                  </h3>
                  <p class="leading-relaxed text-slate-700">
                    The idea came up while I was working on my <a
                      class="font-bold text-red-600"
                      href="/projects/forma">Forma</a
                    > project. I wanted to bring the look of public seating into a
                    home environment. A park bench is something everyone knows, so
                    I used it as a starting point to create something new for indoor
                    use.
                  </p>
                </div>

                <!-- Card 2: Result -->
                <div
                  class="backdrop-blur-md bg-slate-50/40 border border-slate-200 rounded-lg p-8 w-full fly-in-card opacity-0 translate-x-20 transition-all duration-1000 ease-out"
                >
                  <h3
                    class="text-xl font-heading font-semibold mb-3 text-slate-900"
                  >
                    Result
                  </h3>
                  <p class="leading-relaxed text-slate-700">
                    The final design combines two opposites. A strong steel
                    frame gives it a solid shape and an industrial look. Inside
                    this frame sits a soft, upholstered seat that makes it
                    comfortable. This mix of hard metal and soft fabric creates
                    an interesting contrast.
                  </p>
                </div>

                <!-- Card 3: Process -->
                <div
                  class="backdrop-blur-md bg-slate-50/40 border border-slate-200 rounded-lg p-8 w-full fly-in-card opacity-0 translate-x-20 transition-all duration-1000 ease-out"
                >
                  <h3
                    class="text-xl font-heading font-semibold mb-3 text-slate-900"
                  >
                    Process
                  </h3>
                  <p class="leading-relaxed text-slate-700">
                    After drawing the first sketches, I built the entire model
                    in SolidWorks to get the dimensions right. Once the
                    technical part was done, I moved the model to Blender to
                    create the realistic renderings.
                  </p>
                </div>

                <!-- Card 4: Industrial Details -->
                <div
                  class="backdrop-blur-md bg-slate-50/40 border border-slate-200 rounded-lg p-8 w-full fly-in-card opacity-0 translate-x-20 transition-all duration-1000 ease-out"
                >
                  <h3
                    class="text-xl font-heading font-semibold mb-3 text-slate-900"
                  >
                    Industrial Details
                  </h3>
                  <p class="leading-relaxed text-slate-700">
                    The construction is easy to understand. Large screws are
                    used not just to hold it together, but also as a design
                    feature. Nothing is hidden. These visible details show how
                    the piece is built and give it a raw, mechanical look that
                    stands out against the soft fabric.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
